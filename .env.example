COMPOSE_PROJECT_NAME=utec-ia

# Local Docker Compose demo.
FRONTEND_PORT=8080
IMAGE_TAG=local
BACKEND_IMAGE=utec-ia-backend
FRONTEND_IMAGE=utec-ia-frontend

# Runtime metadata exposed by /health and /version.
UTEC_IA_VERSION=0.1.0
UTEC_IA_COMMIT_SHA=local
UTEC_IA_ENVIRONMENT=compose
UTEC_IA_MODE=demo
CORS_ALLOW_ORIGINS=*

# Optional pgvector profile. These values are local-only examples.
POSTGRES_DB=utec_ia
POSTGRES_USER=utec_ia
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Optional observability profile.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
